@model EntityFrameworkCore.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Hitachi Payment Services</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            overflow-x: hidden;
            background-color: #ffffff;
        }

        .login-page {
            min-height: 100vh;
        }

        /* Left Image Section */
        .left-panel {
            min-height: 100vh;
            background-image: url('/images/SchoolImage.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: relative;
        }

        .overlay-content {
            position: absolute;
            bottom: 40px;
            left: 40px;
            color: #fff;
            background: rgba(0, 0, 0, 0.55);
            padding: 20px 25px;
            border-radius: 12px;
        }

            .overlay-content h3 {
                margin-bottom: 10px;
                font-weight: 700;
            }

        /* Right Login Section */
        .right-panel {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #ffffff;
            padding: 40px;
        }

        .login-box {
            width: 100%;
            max-width: 420px;
        }

        .login-title {
            color: orange;
            font-weight: 700;
        }

        .login-subtitle {
            color: #6c757d;
            font-weight:bold;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            height: 50px;
            border-radius: 10px;
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, .25);
            }

        .btn-login {
            height: 50px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 16px;
        }

        .login-links a {
            text-decoration: none;
            font-weight: 500;
        }

            .login-links a:hover {
                text-decoration: underline;
            }

        /* IMPORTANT: Use @@media in Razor Views */
        @@media (max-width: 991px) {
            .left-panel {
                display: none;
            }

            .right-panel {
                padding: 25px;
            }

            .login-box {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="container-fluid login-page">
        <div class="row g-0">

            <!-- Left Side Image -->
            <div class="col-lg-7">
                <div class="left-panel">

                    <div class="overlay-content">
                        <h3>Orchids The International School</h3>
                        <p class="mb-0">
                            Character • Competance • Career Goals
                        </p>
                    </div>

                </div>
            </div>

            <!-- Right Side Login -->
            <div class="col-lg-5">
                <div class="right-panel">

                    <div class="login-box">

                        <div class="text-center mb-5">
                            <img src="~/images/School-Logo.jpg" style="
                                height: 100px;
                                width: 136px;
                                margin-top: -47px;
                            " />
                            
                            <h2 class="login-title" style="margin-top: -19px;">
                                Welcome To Orchids The International School
                            </h2>
                            <p class="login-subtitle">
                                Sign in to access your School account
                            </p>
                        </div>

                        <form asp-controller="Login" asp-action="Login" method="post">

                            <div class="mb-3" style="margin-top: -25px;">
                                <label class="form-label">
                                    Username
                                </label>

                                <input asp-for="Username"
                                       class="form-control"
                                       placeholder="Enter Username" />

                                <span asp-validation-for="Username"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter Password" />

                                <span asp-validation-for="Password"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe"
                                           class="form-check-input"
                                           type="checkbox" />

                                    <label asp-for="RememberMe"
                                           class="form-check-label">
                                        Remember Me
                                    </label>
                                </div>
                            </div>

                            <div class="d-grid mb-4">
                                <button type="submit"
                                        class="btn btn-warning btn-login">
                                    Login
                                </button>
                            </div>

                            <div class="login-links d-flex justify-content-between">
                                <a asp-controller="Login"
                                   asp-action="ForgotPassword"
                                   class="text-primary">
                                    Forgot Password?
                                </a>

                                <span style="margin-left:60px">Don't have an account? </span>
                                <a asp-controller="Login" asp-action="SignUp" class="text-success">
                                    Sign Up
                                </a>
                            </div>

                        </form>

                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "4000",
            "extendedTimeOut": "1000",
            "preventDuplicates": true,
            "newestOnTop": true
        };
    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success('@TempData["Success"]');
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            toastr.error('@TempData["Error"]');
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            toastr.warning('@TempData["Warning"]');
        </script>
    }

    @if (TempData["Info"] != null)
    {
        <script>
            toastr.info('@TempData["Info"]');
        </script>
    }

</body>
</html>