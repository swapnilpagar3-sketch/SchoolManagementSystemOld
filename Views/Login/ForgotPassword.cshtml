@model ForgotPasswordViewModel


@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f7fa;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
        }

        .forgot-container {
            width: 100%;
            max-width: 450px;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .forgot-title {
            text-align: center;
            margin-bottom: 10px;
            font-weight: 700;
            color: #333;
            margin-top: -31px;
        }

        .forgot-subtitle {
            text-align: center;
            color: #6c757d;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .form-control {
            height: 48px;
        }

        .btn-reset {
            height: 48px;
            font-weight: 600;
        }

        .back-login {
            text-align: center;
            margin-top: 20px;
        }

            .back-login a {
                text-decoration: none;
                font-weight: 500;
            }
    </style>
</head>
<body>

    <div class="forgot-container">
        <img src="~/images/School-Logo.jpg" style="
                                height: 130px;
                                width: 136px;
                                margin-top: -38px;
                                margin-left:105px
                            " />
        <h2 class="forgot-title" style="margin-top: -21px;">Forgot Password?</h2>

        <p class="forgot-subtitle">
            Enter your email address and we'll send you a link to reset your password.
        </p>

        <form asp-action="ForgotPassword" method="post">

            @* <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email"
                       name="Email"
                       class="form-control"
                       placeholder="Enter your email"
                       required />
            </div> *@

            <div class="mb-3">
                <label asp-for="EmailAddress"></label>

                <input asp-for="EmailAddress"
                       class="form-control" />

                <span asp-validation-for="EmailAddress"
                      class="text-danger"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-warning btn-reset">
                    Send Reset Link
                </button>
            </div>

        </form>

        <div class="back-login">
            <a asp-action="Login" asp-controller="Login">
                Back to Login
            </a>
        </div>
    </div>

</body>
</html>