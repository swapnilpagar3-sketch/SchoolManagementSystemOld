@model ResetPasswordViewModel

<h2>Reset Password</h2>

<form method="post">

    <input type="hidden"
           asp-for="Token" />

    <div class="mb-3">
        <label>New Password</label>

        <input asp-for="NewPassword"
               type="password"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Confirm Password</label>

        <input asp-for="ConfirmPassword"
               type="password"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Reset Password
    </button>

</form>