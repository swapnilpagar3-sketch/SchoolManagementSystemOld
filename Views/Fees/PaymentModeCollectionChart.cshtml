@using Newtonsoft.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Payment Mode Wise Collection";
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h3 class="mb-0">
            <i class="bi bi-bar-chart-fill me-2"></i>
            Payment Mode Wise Collection Amount
        </h3>

    </div>

    <div class="mt-3 mb-3 ms-3">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-warning">

            <i class="bi bi-grid-3x3-gap-fill me-1"></i>
            Dashboard List

        </a>

    </div>

    <div class="card-body">

        <div style="height:500px;">

            <canvas id="paymentModeChart"></canvas>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    var paymentModes =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.PaymentModes));

    var totalAmounts =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.TotalAmounts));

    // Plugin to display amount on each bar
    const valuePlugin =
    {
        id: 'valuePlugin',

        afterDatasetsDraw(chart)
        {
            const { ctx } = chart;

            ctx.save();

            chart.getDatasetMeta(0).data.forEach(function(bar, index)
            {
                var value =
                    chart.data.datasets[0].data[index];

                ctx.fillStyle = "#000";

                ctx.font = "bold 14px Arial";

                ctx.textAlign = "center";

                ctx.fillText(
                    "₹" + value,
                    bar.x,
                    bar.y - 10
                );
            });

            ctx.restore();
        }
    };

    new Chart(document.getElementById("paymentModeChart"),
    {
        type: 'bar',

        data:
        {
            labels: paymentModes,

            datasets:
            [
                {
                    label: 'Collection Amount',

                    data: totalAmounts,

                    backgroundColor:
                    [
                        '#198754',
                        '#0d6efd',
                        '#ffc107',
                        '#dc3545',
                        '#20c997',
                        '#6f42c1',
                        '#fd7e14',
                        '#6610f2'
                    ],

                    borderColor: '#000',

                    borderWidth: 1
                }
            ]
        },

        plugins:
        [
            valuePlugin
        ],

        options:
        {
            responsive: true,

            maintainAspectRatio: false,

            plugins:
            {
                legend:
                {
                    display: false
                },

                title:
                {
                    display: true,
                    // text: 'Payment Mode Wise Collection Amount',

                    font:
                    {
                        size: 18
                    }
                },

                tooltip:
                {
                    callbacks:
                    {
                        label: function(context)
                        {
                            return "₹ " + context.parsed.y;
                        }
                    }
                }
            },

            scales:
            {
                x:
                {
                    title:
                    {
                        display: true,
                        text: 'Payment Mode'
                    }
                },

                y:
                {
                    beginAtZero: true,

                    title:
                    {
                        display: true,
                        text: 'Collection Amount (₹)'
                    },

                    ticks:
                    {
                        callback: function(value)
                        {
                            return "₹" + value;
                        }
                    }
                }
            }
        }
    });

</script>