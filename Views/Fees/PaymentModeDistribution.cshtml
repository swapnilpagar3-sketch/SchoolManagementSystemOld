@using Newtonsoft.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Payment Mode Distribution";
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h3 class="mb-0">
            <i class="bi bi-pie-chart-fill me-2"></i>
            Payment Mode Distribution
        </h3>

    </div>

    <div class="mt-3 mb-3 ms-3">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-warning">

            <i class="bi bi-grid-3x3-gap-fill me-1"></i>
            Dashboard List

        </a>

    </div>

    <div class="card-body">

        <div style="height:420px; width:100%;">

            <canvas id="paymentChart"></canvas>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

<script>

    var paymentModes =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.PaymentModes));

    var totalPayments =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.TotalPayments));

    var total =
        totalPayments.reduce((a, b) => a + b, 0);

    var ctx =
        document.getElementById("paymentChart").getContext("2d");

    new Chart(ctx,
    {
        type: 'pie',

        data:
        {
            labels: paymentModes,

            datasets:
            [
                {
                    data: totalPayments,

                    backgroundColor:
                    [
                        '#198754',
                        '#0d6efd',
                        '#ffc107',
                        '#dc3545',
                        '#20c997',
                        '#6f42c1',
                        '#fd7e14',
                        '#6610f2'
                    ],

                    borderColor: "#ffffff",

                    borderWidth: 2
                }
            ]
        },

        plugins:
        [
            ChartDataLabels
        ],

        options:
        {
            responsive: true,

            maintainAspectRatio: false,

            plugins:
            {
                legend:
                {
                    position: "right",

                    labels:
                    {
                        font:
                        {
                            size: 13
                        }
                    }
                },

                title:
                {
                    display: true,

                    // text: "Payment Mode Distribution",

                    font:
                    {
                        size: 18
                    }
                },

                datalabels:
                {
                    color: "#ffffff",

                    font:
                    {
                        weight: "bold",
                        size: 14
                    },

                    textAlign: "center",

                    formatter: function(value, context)
                    {
                        var percentage =
                            ((value / total) * 100).toFixed(2);

                        return context.chart.data.labels[context.dataIndex]
                               + "\n"
                               + value
                               + "\n("
                               + percentage
                               + "%)";
                    }
                },

                tooltip:
                {
                    callbacks:
                    {
                        label: function(context)
                        {
                            var percentage =
                                ((context.parsed / total) * 100).toFixed(2);

                            return context.label +
                                   " : " +
                                   context.parsed +
                                   " (" +
                                   percentage +
                                   "%)";
                        }
                    }
                }
            }
        }
    });

</script>