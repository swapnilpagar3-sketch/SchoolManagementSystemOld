@model EntityFrameworkCore.Models.Fee

@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Fee";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash-fill me-2"></i>
                Delete Fee Record
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Are you sure you want to delete this fee record?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Fee ID
                </dt>
                <dd class="col-sm-9">
                    @Model.Id
                </dd>

                <dt class="col-sm-3">
                    Student Name
                </dt>
                <dd class="col-sm-9">
                    @Model.Student?.StudentName
                </dd>

                <dt class="col-sm-3">
                    Fee Date
                </dt>
                <dd class="col-sm-9">
                    @Model.FeeDate.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">
                    Amount
                </dt>
                <dd class="col-sm-9 text-success fw-bold">
                    ₹ @Model.Amount
                </dd>

                <dt class="col-sm-3">
                    Payment Mode
                </dt>
                <dd class="col-sm-9">
                    @Model.PaymentMode
                </dd>

                <dt class="col-sm-3">
                    Remarks
                </dt>
                <dd class="col-sm-9">
                    @Model.Remarks
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash-fill me-1"></i>
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back To List
                </a>

            </form>

        </div>

    </div>

</div>