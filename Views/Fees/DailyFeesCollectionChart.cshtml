@using Newtonsoft.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Daily Fees Collection";
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h3 class="mb-0">

            <i class="bi bi-graph-up-arrow me-2"></i>

            Daily Fees Collection

        </h3>

    </div>

    <div class="mt-3 mb-3 ms-3">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-warning">

            <i class="bi bi-grid-3x3-gap-fill me-1"></i>

            Dashboard List

        </a>

    </div>

    <div class="card-body">

        <canvas id="feesChart"
                style="height:120px;">
        </canvas>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

<script>

    Chart.register(ChartDataLabels);

    var dates =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.Dates));

    var amounts =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.Amounts));

    var ctx =
        document.getElementById('feesChart')
        .getContext('2d');

    new Chart(ctx,
    {
        type: 'line',

        data:
        {
            labels: dates,

            datasets:
            [
                {
                    label: 'Fees Collection (₹)',

                    data: amounts,

                    borderColor: '#198754',

                    backgroundColor: 'rgba(25,135,84,0.20)',

                    borderWidth: 3,

                    pointRadius: 6,

                    pointHoverRadius: 8,

                    pointBackgroundColor: '#198754',

                    fill: true,

                    tension: 0.35,

                    datalabels:
                    {
                        color: '#000',

                        anchor: 'end',

                        align: 'top',

                        font:
                        {
                            weight: 'bold',
                            size: 12
                        },

                        formatter: function(value)
                        {
                            return '₹' + value;
                        }
                    }
                }
            ]
        },

        options:
        {
            responsive: true,

            plugins:
            {
                legend:
                {
                    display: true,
                    position: 'top'
                },

                title:
                {
                    display: true,
                    text: 'Daily Fees Collection'
                }
            },

            scales:
            {
                y:
                {
                    beginAtZero: true,

                    title:
                    {
                        display: true,
                        text: 'Amount (₹)'
                    }
                },

                x:
                {
                    title:
                    {
                        display: true,
                        text: 'Collection Date'
                    }
                }
            }
        }

    });

</script>