@using Newtonsoft.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Exam Wise Total Marks Chart";
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h3 class="mb-0">
            <i class="bi bi-bar-chart-fill me-2"></i>
            Exam Wise Total Marks
        </h3>

    </div>

    <div class="mt-3 mb-3 ms-3">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-warning">

            <i class="bi bi-grid-3x3-gap-fill me-1"></i>
            Dashboard List

        </a>

    </div>

    <div class="card-body">

        <canvas id="examChart" height="100"></canvas>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

<script>

    var examNames =
        @Html.Raw(
            JsonConvert.SerializeObject(
                    ViewBag.ExamNames));

    var totalMarks =
        @Html.Raw(
                        JsonConvert.SerializeObject(
                                ViewBag.TotalMarks));

    Chart.register(ChartDataLabels);

    var ctx =
        document.getElementById('examChart')
            .getContext('2d');

    new Chart(ctx,
    {
        type: 'bar',

        data:
        {
            labels: examNames,

            datasets:
            [
                {
                    label: 'Total Marks',

                    data: totalMarks,

                    backgroundColor:
                    [
                        '#198754',
                        '#0d6efd',
                        '#ffc107',
                        '#dc3545',
                        '#20c997',
                        '#6f42c1',
                        '#fd7e14',
                        '#6610f2',
                        '#198754',
                        '#0dcaf0'
                    ],

                    borderWidth: 1
                }
            ]
        },

        options:
        {
            responsive: true,

            plugins:
            {
                legend:
                {
                    display: true
                },

                title:
                {
                    display: true,
                    text: 'Exam Wise Total Marks'
                },

                datalabels:
                {
                    anchor: 'end',
                    align: 'top',

                    color: '#000',

                    font:
                    {
                        weight: 'bold',
                        size: 14
                    },

                    formatter: function(value)
                    {
                        return value;
                    }
                }
            },

            scales:
            {
                y:
                {
                    beginAtZero: true,

                    max: 120,

                    title:
                    {
                        display: true,
                        text: 'Total Marks'
                    }
                },

                x:
                {
                    title:
                    {
                        display: true,
                        text: 'Exams'
                    }
                }
            }
        }
    });

</script>