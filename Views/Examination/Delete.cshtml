@model EntityFrameworkCore.Models.Exam

@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Exam";
}

<div class="container mt-4">
    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash-fill me-2"></i>
                Delete Exam
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Are you sure you want to delete this exam?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Exam ID
                </dt>
                <dd class="col-sm-9">
                    @Model.Id
                </dd>

                <dt class="col-sm-3">
                    Exam Name
                </dt>
                <dd class="col-sm-9">
                    @Model.ExamName
                </dd>

                <dt class="col-sm-3">
                    Exam Date
                </dt>
                <dd class="col-sm-9">
                    @Model.ExamDate.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">
                    Total Marks
                </dt>
                <dd class="col-sm-9">
                    @Model.TotalMarks
                </dd>

                <dt class="col-sm-3">
                    Passing Marks
                </dt>
                <dd class="col-sm-9">
                    @Model.PassingMarks
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash-fill me-1"></i>
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back To List
                </a>

            </form>

        </div>

    </div>
</div>