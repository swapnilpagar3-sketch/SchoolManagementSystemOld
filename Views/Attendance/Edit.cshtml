@model EntityFrameworkCore.Models.Attendance

@{
    ViewData["Title"] = "Edit Attendance";
}

<div class="card shadow border-0">
    <div class="card-header bg-warning text-white">
        <h3 class="mb-0">
            <i class="bi bi-pencil-square me-2"></i>
            Edit Attendance Record
        </h3>
    </div>

    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="StudentId" class="form-label fw-semibold"></label>
                <select asp-for="StudentId"
                        class="form-control"
                        asp-items="ViewBag.StudentId">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AttendanceDate" class="form-label fw-semibold"></label>
                <input asp-for="AttendanceDate" class="form-control" 
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="AttendanceDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-semibold"></label>
                <select asp-for="Status" class="form-control">
                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>
                    @* <option value="Late">Late</option>
                    <option value="Excused">Excused</option> *@
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mt-4 border-top pt-3">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save-fill me-1"></i> Update Attendance
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left-circle-fill me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}