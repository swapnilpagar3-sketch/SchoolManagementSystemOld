@model EntityFrameworkCore.Models.Attendance

@{
    ViewData["Title"] = "Delete Attendance Record";
}

<div class="container mt-4">
    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash-fill me-2"></i>
                Delete Attendance Record
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Are you sure you want to permanently delete this attendance record?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Record ID
                </dt>
                <dd class="col-sm-9">
                    @Model.Id
                </dd>

                <dt class="col-sm-3">
                    Student Name
                </dt>
                <dd class="col-sm-9">
                    @* Displays the Student name safely if the navigation property is included *@
                    @(Model.Student != null ? Model.Student.StudentName : $"Student ID: {Model.StudentId}")
                </dd>

                <dt class="col-sm-3">
                    Attendance Date
                </dt>
                <dd class="col-sm-9">
                    @Model.AttendanceDate.ToString("dd-MMM-yyyy")
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>
                <dd class="col-sm-9">
                    @* Dynamically applies color badges depending on whether they were present or absent *@
                    @if (Model.Status == "Present")
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                    else if (Model.Status == "Absent")
                    {
                        <span class="badge bg-danger">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    }
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash-fill me-1"></i>
                    Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back To List
                </a>

            </form>

        </div>

    </div>
</div>