@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<EntityFrameworkCore.Models.Attendance>

@{
    ViewData["Title"] = "Attendance List";

    bool isLoading = ViewData["IsLoading"] as bool? ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/litepicker/dist/css/litepicker.css">
    <style>
        /* Optional: Gives the Apply/Cancel action buttons panel a clean look matching Bootstrap */
        .litepicker .container__footer {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 10px;
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
        }

            .litepicker .container__footer button.btn-action-apply {
                background-color: #0d6efd !important;
                color: #fff !important;
                border-radius: 4px;
                padding: 4px 12px;
            }

            .litepicker .container__footer button.btn-action-cancel {
                background-color: #6c757d !important;
                color: #fff !important;
                border-radius: 4px;
                padding: 4px 12px;
            }
    </style>
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <div class="d-flex justify-content-between align-items-center">

            <h3 class="mb-0">
                <i class="bi bi-calendar-check-fill me-2"></i>
                Attendance List
            </h3>

            <span class="badge bg-light text-dark fs-6">
                Total Records: @Model.TotalItemCount
            </span>

        </div>

    </div>

    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row mb-3 align-items-end">

                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        Student Name
                    </label>

                    <input type="text"
                           name="studentName"
                           value="@ViewBag.StudentName"
                           class="form-control"
                           placeholder="Enter Student Name" />
                </div>

                <div class="col-md-3" style="margin-left: -16px;">
                    <label class="form-label fw-bold">
                        Attendance Date
                    </label>

                    <input type="text"
                           id="attendanceDateRange"
                           name="attendanceDateRange"
                           value="@ViewBag.AttendanceDateRange"
                           class="form-control"
                           placeholder="Select Date Range" />
                </div>

                <div class="col-md-2" style="margin-left: -16px;">
                    <label class="form-label fw-bold">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">All</option>

                        @if (ViewBag.Status == "Present")
                        {
                            <option value="Present" selected>
                                Present
                            </option>
                        }
                        else
                        {
                            <option value="Present">
                                Present
                            </option>
                        }

                        @if (ViewBag.Status == "Absent")
                        {
                            <option value="Absent" selected>
                                Absent
                            </option>
                        }
                        else
                        {
                            <option value="Absent">
                                Absent
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-2" style="width: 121px;">
                    <button type="submit"
                            class="btn btn-primary w-100" style="margin-left: -12px;">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>
                </div>

                <div class="col-md-4">

                    <div class="d-flex gap-2">

                        <a asp-action="Create"
                           class="btn btn-success"
                           style="width:172px;height:38px;margin-top:23px;">
                            <i class="bi bi-plus-circle-fill me-1"></i>
                            Mark Attendance
                        </a>

                        <a asp-action="ExportToExcel"
                           id="btnExport"
                           asp-route-studentName="@ViewBag.StudentName"
                           asp-route-attendanceDateRange="@ViewBag.AttendanceDateRange"
                           asp-route-status="@ViewBag.Status"
                           class="btn btn-info text-white"
                           style="height:38px;margin-top:23px;margin-left: 24px;">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i>
                            Export
                        </a>

                    </div>

                </div>

            </div>

        </form>

        <div class="table-responsive">

            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark">

                    <tr>
                        <th class="text-center">
                            Student
                        </th>

                        <th class="text-center">
                            Attendance Date
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center" width="220">
                            Actions
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Student?.StudentName
                                </td>

                                <td class="text-center">
                                    @item.AttendanceDate.ToString("dd-MM-yyyy")
                                </td>

                                <td class="text-center">

                                    @if (item.Status == "Present")
                                    {
                                        <span class="badge bg-success">
                                            Present
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Absent
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash-fill"></i>
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4"
                                class="text-center text-danger fw-bold">

                                No Attendance Records Found

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="card-footer bg-light">

        <div class="row align-items-center">

            <div class="col-md-4">

                <span class="badge bg-secondary">
                    Total Pages: @Model.PageCount
                </span>

            </div>

            <div class="col-md-4 text-center">

                @Html.PagedListPager(
                Model,
                page => Url.Action(
                                "Index",
                                new
                                {
                                    page,
                                    studentName = ViewBag.StudentName,
                                    attendanceDateRange = ViewBag.AttendanceDateRange,
                                    status = ViewBag.Status
                                }),
                                new PagedListRenderOptions
                                {
                                    DisplayLinkToFirstPage =
                                PagedListDisplayMode.Always,

                                    DisplayLinkToLastPage =
                                PagedListDisplayMode.Always,

                                    DisplayLinkToPreviousPage =
                                PagedListDisplayMode.Always,

                                    DisplayLinkToNextPage =
                                PagedListDisplayMode.Always,

                                    LiElementClasses =
                                new[] { "page-item" },

                                    PageClasses =
                                new[] { "page-link" }
                                })

            </div>

            <div class="col-md-4 text-end">

                <span class="badge bg-primary">
                    Page @Model.PageNumber of @Model.PageCount
                </span>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/litepicker/dist/litepicker.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/litepicker/dist/plugins/ranges.js"></script>

    <script>
        const picker = new Litepicker({
            element: document.getElementById('attendanceDateRange'),
            singleMode: false,
            numberOfMonths: 2,
            numberOfColumns: 2,
            format: 'YYYY-MM-DD',
            separator: ' to ',
            autoApply: false, // Prevents automatic selection closing without clicking Apply
            plugins: ['ranges'],
            buttonText: {
                apply: 'Apply',
                cancel: 'Clear' // Changes default 'Cancel' label text to 'Clear'
            }
        });

        // Event listener to clear the input field completely when 'Clear' is clicked
        picker.on('button:cancel', () => {
            document.getElementById('attendanceDateRange').value = '';
        });

        // --- EXPORT TO EXCEL EVENT LISTENER ---
        document.getElementById("btnExport").addEventListener("click", function (e) {
            e.preventDefault();

            var studentName = document.querySelector("input[name='studentName']").value;
            var attendanceDateRange = document.getElementById("attendanceDateRange").value;
            var status = document.querySelector("select[name='status']").value;

            var url = '@Url.Action("ExportToExcel", "Attendance")'
                + '?studentName=' + encodeURIComponent(studentName)
                + '&attendanceDateRange=' + encodeURIComponent(attendanceDateRange)
                + '&status=' + encodeURIComponent(status);

            window.location.href = url;
        });
    </script>
}