@model Product

<h3>Are you sure you want to delete this product?</h3>

<form method="post">

    <input type="hidden" asp-for="ProductId" />

    <p>
        <strong>@Model.ProductName</strong>
    </p>

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>