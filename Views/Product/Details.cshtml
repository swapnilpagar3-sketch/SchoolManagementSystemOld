@model Product

<h2>Product Details</h2>

<a asp-action="Index" class="btn btn-info" style="margin-top: 10px;
    margin-left: 8px;">
    ← Back to List
</a>

<table class="table table-bordered" style="margin-top:20px">

    <tr>
        <th>Product Id</th>
        <td>@Model.ProductId</td>
    </tr>

    <tr>
        <th>Product Name</th>
        <td>@Model.ProductName</td>
    </tr>

    <tr>
        <th>Category</th>
        <td>@Model.Category</td>
    </tr>

    <tr>
        <th>Quantity</th>
        <td>@Model.Quantity</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>@Model.Price</td>
    </tr>

</table>