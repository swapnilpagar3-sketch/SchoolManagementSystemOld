@{
    var username = Context.Request.Cookies["Username"];
    var profileImage = Context.Request.Cookies["ProfileImage"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EntityFrameworkCore.styles.css" asp-append-version="true" />

    <!-- Toastr -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        html {
            height: 100%;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f8f9fa;
            margin: 0;
        }

        .navbar-brand {
            font-size: 1.3rem;
            font-weight: 700;
        }

        .content-wrapper {
            flex: 1;
            padding: 20px;
        }

        .main-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 0.125rem 0.75rem rgba(0,0,0,.08);
            background-color: #fff;
        }

        .footer-custom {
            background-color: #ffffff;
            border-top: 1px solid #dee2e6;
            margin-top: auto;
        }

        .nav-link {
            font-weight: 500;
        }

        .logout-btn {
            font-weight: 600;
        }

        .navbar .nav-link {
            transition: all 0.3s ease;
            border-radius: 8px;
        }

            .navbar .nav-link:hover {
                background: rgba(255,255,255,0.15);
                transform: translateY(-2px);
            }

        .dropdown-menu {
            border-radius: 12px;
        }

        .dropdown-item:hover {
            background-color: #f1f5f9;
            padding-left: 20px;
            transition: all 0.2s;
        }

        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu > .dropdown-menu {
                top: 0;
                left: 100%;
                margin-top: -1px;
                display: none;
            }

            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }

            .dropdown-submenu > a::after {
                float: right;
                margin-top: 8px;
                /* content: "▶"; */
                font-size: 10px;
            }

        .search-highlight {
            background: yellow;
            color: black;
            padding: 1px;
        }

        .search-current {
            background: orange;
            color: black;
            font-weight: bold;
        }

        @@media (max-width: 768px) {
            .content-wrapper {
                padding: 10px;
            }
        }
    </style>
</head>
<body>

