@using Newtonsoft.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Exam Wise Pass vs Fail";
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h3 class="mb-0">

            <i class="bi bi-bar-chart-fill me-2"></i>

            Exam Wise Pass vs Fail

        </h3>

    </div>

    <div class="mt-3 mb-3 ms-3">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-warning">

            <i class="bi bi-grid-3x3-gap-fill me-1"></i>

            Dashboard List

        </a>

    </div>

    <div class="card-body">

        <canvas id="passFailChart"
                style="height:120px;">
        </canvas>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    var examNames =
        @Html.Raw(
            JsonConvert.SerializeObject(
                    ViewBag.ExamNames));

    var passCount =
        @Html.Raw(
                        JsonConvert.SerializeObject(
                                ViewBag.PassCount));

    var failCount =
        @Html.Raw(
                        JsonConvert.SerializeObject(
                                ViewBag.FailCount));

    const valuePlugin =
    {
        id: 'valuePlugin',

        afterDatasetsDraw(chart)
        {
            const { ctx } = chart;

            chart.data.datasets.forEach((dataset, datasetIndex) =>
            {
                const meta =
                    chart.getDatasetMeta(datasetIndex);

                meta.data.forEach((bar, index) =>
                {
                    var value =
                        dataset.data[index];

                    if(value==0)
                        return;

                    ctx.save();

                    ctx.font =
                        "bold 12px Arial";

                    ctx.fillStyle =
                        "black";

                    ctx.textAlign =
                        "center";

                    ctx.fillText(
                        value,
                        bar.x,
                        bar.y + 15
                    );

                    ctx.restore();

                });

            });

        }

    };

    const ctx =
        document.getElementById("passFailChart")
            .getContext("2d");

    new Chart(ctx,
    {
        type: "bar",

        data:
        {
            labels: examNames,

            datasets:
            [
                {
                    label: "Pass",

                    data: passCount,

                    backgroundColor: "#198754"
                },

                {
                    label: "Fail",

                    data: failCount,

                    backgroundColor: "#dc3545"
                }
            ]
        },

        options:
        {
            responsive: true,

            plugins:
            {
                title:
                {
                    display: true,

                    text: "Exam Wise Pass vs Fail Analysis"
                },

                legend:
                {
                    position: "top"
                }
            },

            scales:
            {
                x:
                {
                    stacked: true,

                    title:
                    {
                        display: true,

                        text: "Exams"
                    }
                },

                y:
                {
                    stacked: true,

                    beginAtZero: true,

                    ticks:
                    {
                        stepSize: 1
                    },

                    title:
                    {
                        display: true,

                        text: "Number of Students"
                    }
                }
            }
        },

        plugins: [valuePlugin]

    });

</script>