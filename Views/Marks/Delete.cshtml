@model EntityFrameworkCore.Models.StudentExamMarks

@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Student Marks";
}

<div class="container mt-4">
    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash-fill me-2"></i>
                Delete Student Marks
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Are you sure you want to delete this student marks record?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Record ID
                </dt>
                <dd class="col-sm-9">
                    @Model.Id
                </dd>

                <dt class="col-sm-3">
                    Student
                </dt>
                <dd class="col-sm-9">
                    @Model.Student?.StudentName
                </dd>

                <dt class="col-sm-3">
                    Exam
                </dt>
                <dd class="col-sm-9">
                    @Model.Exam?.ExamName
                </dd>

                <dt class="col-sm-3">
                    Obtained Marks
                </dt>
                <dd class="col-sm-9">
                    @Model.ObtainedMarks
                </dd>

                <dt class="col-sm-3">
                    Total Marks
                </dt>
                <dd class="col-sm-9">
                    @Model.Exam?.TotalMarks
                </dd>

                <dt class="col-sm-3">
                    Passing Marks
                </dt>
                <dd class="col-sm-9">
                    @Model.Exam?.PassingMarks
                </dd>

                <dt class="col-sm-3">
                    Result
                </dt>
                <dd class="col-sm-9">

                    @if (Model.Exam != null &&
                                        Model.ObtainedMarks >= Model.Exam.PassingMarks)
                    {
                        <span class="badge bg-success">
                            Pass
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Fail
                        </span>
                    }

                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash-fill me-1"></i>
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back To List
                </a>

            </form>

        </div>

    </div>
</div>