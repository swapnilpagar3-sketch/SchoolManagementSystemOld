@using Newtonsoft.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Pass Percentage Per Exam";
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h3 class="mb-0">

            <i class="bi bi-graph-up-arrow me-2"></i>

            Pass Percentage Per Exam

        </h3>

    </div>

    <div class="mt-3 mb-3 ms-3">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-warning">

            <i class="bi bi-grid-3x3-gap-fill me-1"></i>

            Dashboard List

        </a>

    </div>

    <div class="card-body">

        <canvas id="percentageChart"
                style="height:120px;">
        </canvas>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    var examNames =
        @Html.Raw(
            JsonConvert.SerializeObject(
                    ViewBag.ExamNames));

    var percentage =
        @Html.Raw(
                        JsonConvert.SerializeObject(
                                ViewBag.PassPercentage));

    const valuePlugin =
    {
        id: 'valuePlugin',

        afterDatasetsDraw(chart)
        {
            const { ctx } = chart;

            chart.data.datasets.forEach((dataset, datasetIndex) =>
            {
                const meta =
                    chart.getDatasetMeta(datasetIndex);

                meta.data.forEach((bar, index) =>
                {
                    var value =
                        dataset.data[index];

                    ctx.save();

                    ctx.font =
                        "bold 12px Arial";

                    ctx.fillStyle =
                        "black";

                    ctx.textAlign =
                        "center";

                    ctx.fillText(
                        value + "%",
                        bar.x,
                        bar.y - 8
                    );

                    ctx.restore();

                });

            });

        }

    };

    var ctx =
        document.getElementById("percentageChart")
            .getContext("2d");

    new Chart(ctx,
    {
        type: "bar",

        data:
        {
            labels: examNames,

            datasets:
            [
                {
                    label: "Pass Percentage",

                    data: percentage,

                    backgroundColor:
                    [
                        "#198754",
                        "#0d6efd",
                        "#ffc107",
                        "#dc3545",
                        "#20c997",
                        "#6f42c1",
                        "#fd7e14",
                        "#0dcaf0",
                        "#6610f2",
                        "#198754"
                    ],

                    borderWidth: 1
                }
            ]
        },

        options:
        {
            responsive: true,

            plugins:
            {
                legend:
                {
                    display: false
                },

                title:
                {
                    display: true,

                    text: "Exam Wise Pass Percentage"
                }
            },

            scales:
            {
                y:
                {
                    beginAtZero: true,

                    max: 100,

                    ticks:
                    {
                        callback: function(value)
                        {
                            return value + "%";
                        }
                    },

                    title:
                    {
                        display: true,

                        text: "Pass Percentage"
                    }
                },

                x:
                {
                    title:
                    {
                        display: true,

                        text: "Exams"
                    }
                }
            }
        },

        plugins: [valuePlugin]

    });

</script>