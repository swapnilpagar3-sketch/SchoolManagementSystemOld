@using Newtonsoft.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Average Marks vs Total Marks";
}

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h3 class="mb-0">
            <i class="bi bi-bar-chart-fill me-2"></i>
            Average Marks vs Total Marks
        </h3>

    </div>

    <div class="mt-3 mb-3 ms-3">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-warning">

            <i class="bi bi-grid-3x3-gap-fill me-1"></i>
            Dashboard List

        </a>

    </div>

    <div class="card-body">

        <canvas id="avgChart"
                style="height:130px;">
        </canvas>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

<script>

    Chart.register(ChartDataLabels);

    var examNames =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.ExamNames));

    var totalMarks =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.TotalMarks));

    var averageMarks =
        @Html.Raw(JsonConvert.SerializeObject(ViewBag.AverageMarks));

    var ctx =
        document.getElementById('avgChart')
        .getContext('2d');

    new Chart(ctx,
    {
        type: 'bar',

        data:
        {
            labels: examNames,

            datasets:
            [
                {
                    label: 'Total Marks',

                    data: totalMarks,

                    backgroundColor: '#0d6efd',

                    borderWidth: 1,

                    datalabels:
                    {
                        color: '#000',

                        anchor: 'end',

                        align: 'top',

                        font:
                        {
                            weight: 'bold',
                            size: 12
                        },

                        formatter: function(value)
                        {
                            return value;
                        }
                    }
                },

                {
                    label: 'Average Marks',

                    data: averageMarks,

                    backgroundColor: '#198754',

                    borderWidth: 1,

                    datalabels:
                    {
                        color: '#000',

                        anchor: 'end',

                        align: 'top',

                        font:
                        {
                            weight: 'bold',
                            size: 12
                        },

                        formatter: function(value)
                        {
                            return value.toFixed(2);
                        }
                    }
                }
            ]
        },

        options:
        {
            responsive: true,

            plugins:
            {
                legend:
                {
                    position: 'top'
                },

                title:
                {
                    display: true,

                    text: 'Exam Wise Average Marks vs Total Marks'
                }
            },

            scales:
            {
                y:
                {
                    beginAtZero: true,

                    max: 120,

                    title:
                    {
                        display: true,

                        text: 'Marks'
                    }
                },

                x:
                {
                    title:
                    {
                        display: true,

                        text: 'Exams'
                    }
                }
            }
        }
    });

</script>