@model Teacher

@{
    Layout = "_Layout";
    ViewData["Title"] = "Teacher Details";
}

<div class="container mt-4">
    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-workspace me-2"></i>
                Teacher Details
            </h3>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Teacher ID
                </div>
                <div class="col-md-9">
                    @Model.Id
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Name
                </div>
                <div class="col-md-9">
                    @Model.Name
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Skills
                </div>
                <div class="col-md-9">
                    @Model.Skills
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Total Students
                </div>
                <div class="col-md-9">
                    @Model.TotalStudents
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Salary
                </div>
                <div class="col-md-9 text-success fw-bold">
                    @string.Format(
                    new System.Globalization.CultureInfo("en-IN"),
                                        "{0:C2}",
                                        Model.Salary)
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Teacher Image
                </div>

                <div class="col-md-9">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="Teacher Image"
                             class="img-thumbnail shadow-sm"
                             style="max-width:250px;" />
                    }
                    else
                    {
                        <span class="text-muted">
                            No Image Available
                        </span>
                    }

                </div>
            </div>

        </div>

        <div class="card-footer">

            <a asp-action="Update"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back To List
            </a>

        </div>

    </div>
</div>