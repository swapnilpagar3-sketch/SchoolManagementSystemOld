@model Teacher

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Teacher";
}

<div class="container mt-4">
    <div class="card shadow">

        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Teacher
            </h3>
        </div>

        <div class="card-body">

            <form method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Id"
                               class="form-label"></label>

                        <input asp-for="Id"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name"
                               class="form-label"></label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Skills"
                               class="form-label"></label>

                        <input asp-for="Skills"
                               class="form-control" />

                        <span asp-validation-for="Skills"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TotalStudents"
                               class="form-label"></label>

                        <input asp-for="TotalStudents"
                               class="form-control" />

                        <span asp-validation-for="TotalStudents"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Salary"
                               class="form-label"></label>

                        <input asp-for="Salary"
                               class="form-control" />

                        <span asp-validation-for="Salary"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ImageFile"
                               class="form-label">
                            Upload New Image
                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control" />
                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Current Image
                    </label>

                    <br />

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="Teacher Image"
                             class="img-thumbnail shadow-sm mb-2"
                             style="max-width:250px;" />

                        <div class="text-success small">
                            @Model.ImageUrl
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">
                            No Image Available
                        </span>
                    }

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-success">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Update
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i>
                        Back To List
                    </a>

                </div>

            </form>

        </div>

    </div>
</div>

@section Scripts
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}