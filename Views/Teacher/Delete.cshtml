@model Teacher

@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Teacher";
}

<div class="container mt-4">
    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-trash-fill me-2"></i>
                Delete Teacher
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Are you sure you want to delete this teacher?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Teacher ID
                </dt>
                <dd class="col-sm-9">
                    @Model.Id
                </dd>

                <dt class="col-sm-3">
                    Name
                </dt>
                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Skills
                </dt>
                <dd class="col-sm-9">
                    @Model.Skills
                </dd>

                <dt class="col-sm-3">
                    Total Students
                </dt>
                <dd class="col-sm-9">
                    @Model.TotalStudents
                </dd>

                <dt class="col-sm-3">
                    Salary
                </dt>
                <dd class="col-sm-9 text-success fw-bold">
                    @string.Format(
                    new System.Globalization.CultureInfo("en-IN"),
                                        "{0:C2}",
                                        Model.Salary)
                </dd>

                <dt class="col-sm-3">
                    Teacher Image
                </dt>
                <dd class="col-sm-9">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="Teacher Image"
                             class="img-thumbnail shadow-sm"
                             style="max-width:250px;" />
                    }
                    else
                    {
                        <span class="text-muted">
                            No Image Available
                        </span>
                    }

                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash-fill me-1"></i>
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back To List
                </a>

            </form>

        </div>

    </div>
</div>