@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">

            <h2 class="mb-0">
                <i class="bi bi-shield-lock-fill me-2"></i>
                Privacy Policy
            </h2>

        </div>

        <div class="card-body">

            <div class="text-center mb-4">

                <i class="bi bi-shield-check text-success"
                   style="font-size:70px;"></i>

                <h3 class="mt-3 text-primary">
                    Orchids The International School
                </h3>

                <p class="text-muted">
                    Your privacy and data security are our highest priorities.
                </p>

            </div>

            <hr />

            <h4 class="text-primary">
                <i class="bi bi-info-circle-fill me-2"></i>
                Introduction
            </h4>

            <p>
                Welcome to the <strong>School Management System</strong> of
                <strong>Orchids The International School</strong>.
                We are committed to protecting the privacy and confidentiality
                of our students, parents, teachers, and staff.
                This Privacy Policy explains how we collect, use, store,
                and protect your information while using this application.
            </p>

            <hr />

            <h4 class="text-success">
                <i class="bi bi-person-vcard-fill me-2"></i>
                Information We Collect
            </h4>

            <ul>

                <li>Student information and academic records.</li>

                <li>Teacher and staff information.</li>

                <li>Attendance records.</li>

                <li>Examination and result details.</li>

                <li>Fee payment information.</li>

                <li>User account credentials for authentication.</li>

            </ul>

            <hr />

            <h4 class="text-warning">
                <i class="bi bi-database-fill me-2"></i>
                How We Use Your Information
            </h4>

            <ul>

                <li>To manage academic records efficiently.</li>

                <li>To maintain attendance and examination records.</li>

                <li>To process fee payments securely.</li>

                <li>To generate analytical reports and dashboards.</li>

                <li>To improve the quality of school services.</li>

            </ul>

            <hr />

            <h4 class="text-danger">
                <i class="bi bi-lock-fill me-2"></i>
                Data Security
            </h4>

            <p>
                We implement appropriate technical and administrative
                safeguards to protect personal information against
                unauthorized access, modification, disclosure, or loss.
                Access to sensitive information is restricted to authorized
                personnel only.
            </p>

            <hr />

            <h4 class="text-info">
                <i class="bi bi-share-fill me-2"></i>
                Information Sharing
            </h4>

            <p>
                Personal information is never sold or shared with third
                parties except when required by law or for legitimate
                educational and administrative purposes.
            </p>

            <hr />

            <h4 class="text-secondary">
                <i class="bi bi-envelope-fill me-2"></i>
                Contact Us
            </h4>

            <div class="alert alert-light border">

                <p class="mb-2">
                    <i class="bi bi-building me-2 text-primary"></i>
                    <strong>Orchids The International School</strong>
                </p>

                <p class="mb-2">
                    <i class="bi bi-geo-alt-fill me-2 text-danger"></i>
                    India
                </p>

                <p class="mb-2">
                    <i class="bi bi-telephone-fill me-2 text-success"></i>
                    +91 1800-889-9999
                </p>

                <p class="mb-0">
                    <i class="bi bi-envelope-fill me-2 text-info"></i>
                    info@orchidsinternationalschool.com
                </p>

            </div>

        </div>

        @* <div class="card-footer text-center text-muted">

            <small>
                © @DateTime.Now.Year
                Orchids The International School |
                School Management System
            </small>

        </div> *@

    </div>

</div>