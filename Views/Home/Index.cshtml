@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Welcome Banner -->
    <div class="card border-0 shadow-lg mb-4"
         style="background: linear-gradient(135deg, #0dcaf0, #31d2f2);">

        <div class="card-body text-white p-5">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h1 class="display-5 fw-bold">
                        Welcome To School Management System
                    </h1>

                    <p class="lead mb-0">
                        Manage Students, Teachers, Classes, Subjects and Attendance
                        efficiently from one place.
                    </p>

                </div>

                <div class="col-md-4 text-center">

                    <i class="bi bi-mortarboard-fill"
                       style="font-size:120px; opacity:0.85;">
                    </i>

                </div>

            </div>

        </div>

    </div>

    <!-- Statistics Cards -->

    <div class="row g-4 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="mb-3">
                        <i class="bi bi-person-fill text-primary"
                           style="font-size:45px;"></i>
                    </div>

                    <h5 class="fw-bold">
                        Students
                    </h5>

                    <h2 class="text-primary">
                        @ViewBag.TotalStudents
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="mb-3">
                        <i class="bi bi-mortarboard-fill text-success"
                           style="font-size:45px;"></i>
                    </div>

                    <h5 class="fw-bold">
                        Teachers
                    </h5>

                    <h2 class="text-success">
                        @ViewBag.TotalTeachers
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="mb-3">
                        <i class="bi bi-door-open-fill text-warning"
                           style="font-size:45px;"></i>
                    </div>

                    <h5 class="fw-bold">
                        Classes
                    </h5>

                    <h2 class="text-warning">
                        @ViewBag.TotalClasses
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="mb-3">
                        <i class="bi bi-book-fill text-danger"
                           style="font-size:45px;"></i>
                    </div>

                    <h5 class="fw-bold">
                        Subjects
                    </h5>

                    <h2 class="text-danger">
                        @ViewBag.TotalSubjects
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="card border-0 shadow">

        <div class="card-header bg-light">

            <h4 class="mb-0">
                <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
                Quick Actions
            </h4>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <a asp-controller="Students"
                       asp-action="Create"
                       class="btn btn-primary w-100 py-3">

                        <i class="bi bi-person-plus-fill me-2"></i>
                        Add Student

                    </a>

                </div>

                <div class="col-md-3">

                    <a asp-controller="Teacher"
                       asp-action="Create"
                       class="btn btn-success w-100 py-3">

                        <i class="bi bi-mortarboard-fill me-2"></i>
                        Add Teacher

                    </a>

                </div>

                <div class="col-md-3">

                    <a asp-controller="Attendance"
                       asp-action="Create"
                       class="btn btn-warning w-100 py-3">

                        <i class="bi bi-calendar-check-fill me-2"></i>
                        Attendance

                    </a>

                </div>

                <div class="col-md-3">

                    <a asp-controller="Home"
                       asp-action="Dashboard"
                       class="btn btn-info text-white w-100 py-3">

                        <i class="bi bi-bar-chart-fill me-2"></i>
                        Reports

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Footer Message -->

    <div class="text-center mt-5">

        <h5 class="text-muted">
            <i class="bi bi-shield-check text-success me-2"></i>
            School Management System Dashboard
        </h5>

        <p class="text-muted">
            Manage your school operations with ease and efficiency.
        </p>

    </div>

</div>