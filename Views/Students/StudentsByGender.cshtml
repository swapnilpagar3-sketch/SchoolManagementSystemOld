@{
    Layout = "_Layout";
    ViewData["Title"] = "Students By Gender";
}

<div class="card-header bg-success text-white">
    <h3 class="mb-0">
        <i class="bi bi-pie-chart-fill me-2"></i>
        Students By Gender
    </h3>
</div>

<div class="mt-3 mb-3">

    <a asp-controller="Home"
       asp-action="Dashboard"
       class="btn btn-warning">

        <i class="bi bi-grid-3x3-gap-fill me-1"></i>
        Dashboard List

    </a>

</div>

<!-- KPI Cards -->
<div class="row mb-4" style="margin-top:10px">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body text-center">

                <h6 class="text-uppercase mb-2">
                    Total Students
                </h6>

                <h2 class="fw-bold mb-0">
                    @ViewBag.TotalStudents
                </h2>

            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body text-center">

                <h6 class="text-uppercase mb-2">
                    Gender Categories
                </h6>

                <h2 class="fw-bold mb-0">
                    @ViewBag.TotalCategories
                </h2>

            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body text-center">

                <h6 class="text-uppercase mb-2">
                    Highest Count
                </h6>

                <h2 class="fw-bold mb-0">
                    @ViewBag.HighestCount
                </h2>

            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body text-center">

                <h6 class="text-uppercase mb-2">
                    Lowest Count
                </h6>

                <h2 class="fw-bold mb-0">
                    @ViewBag.LowestCount
                </h2>

            </div>
        </div>
    </div>

</div>

<!-- Pie Chart -->
<div class="card shadow">

    <div class="card-body">

        <div class="d-flex justify-content-center">

            <div style="width:500px; height:500px;">
                <canvas id="genderPieChart"></canvas>
            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <script>

        var genderData =
            @Html.Raw(ViewBag.ChartData);

        var labels =
            genderData.map(x => x.Gender);

        var students =
            genderData.map(x => x.TotalStudents);

        var total =
            students.reduce((a, b) => a + b, 0);

        var ctx =
            document.getElementById('genderPieChart');

        new Chart(ctx,
        {
            type: 'pie',

            data:
            {
                labels: labels,

                datasets:
                [{
                    data: students,

                    backgroundColor:
                    [
                        '#36A2EB',
                        '#FF6384',
                        '#FFCE56',
                        '#4BC0C0',
                        '#9966FF',
                        '#FF9F40'
                    ],

                    borderColor: "#ffffff",
                    borderWidth: 2
                }]
            },

            plugins: [ChartDataLabels],

            options:
            {
                responsive: true,

                maintainAspectRatio: false,

                plugins:
                {
                    legend:
                    {
                        position: 'bottom',

                        labels:
                        {
                            boxWidth: 15,
                            padding: 15,
                            font:
                            {
                                size: 12
                            }
                        }
                    },

                    datalabels:
                    {
                        color: '#ffffff',

                        font:
                        {
                            weight: 'bold',
                            size: 14
                        },

                        formatter: function(value, context)
                        {
                            var percentage =
                                ((value / total) * 100)
                                .toFixed(1);

                            var gender =
                                context.chart.data.labels[context.dataIndex];

                            return gender +
                                   '\n' +
                                   percentage +
                                   '%';
                        },

                        textAlign: 'center',

                        anchor: 'center',
                        align: 'center'
                    },

                    tooltip:
                    {
                        callbacks:
                        {
                            label: function(context)
                            {
                                var value =
                                    context.raw;

                                var percentage =
                                    ((value / total) * 100)
                                    .toFixed(2);

                                return context.label +
                                       ' : ' +
                                       percentage +
                                       '% (' +
                                       value +
                                       ' Students)';
                            }
                        }
                    }
                }
            }
        });

    </script>
}