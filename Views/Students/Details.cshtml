@model EntityFrameworkCore.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-vcard-fill me-2"></i>
                Student Details
            </h3>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Student ID
                </div>
                <div class="col-md-9">
                    @Model.Id
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Student Name
                </div>
                <div class="col-md-9">
                    @Model.StudentName
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Gender
                </div>
                <div class="col-md-9">
                    @Model.Gender
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Date Of Birth
                </div>
                <div class="col-md-9">
                    @Model.DateOfBirth.ToString("dd-MMM-yyyy")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Mobile No
                </div>
                <div class="col-md-9">
                    @Model.MobileNo
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Address
                </div>
                <div class="col-md-9">
                    @Model.Address
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Admission Date
                </div>
                <div class="col-md-9">
                    @Model.AdmissionDate.ToString("dd-MMM-yyyy")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Class ID
                </div>
                <div class="col-md-9">
                    @Model.ClassId
                </div>
            </div>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back To List
            </a>

        </div>

    </div>
</div>